# Dependencies and build output
**/node_modules/
**/dist/
**/dist-ssr/

# Environment files and secrets (keep example templates)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs and local state
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.local
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Generated uploads should be stored persistently outside the source checkout
backend/uploads/*
!backend/uploads/.gitkeep
